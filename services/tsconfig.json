{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    
    "rootDir": "./playground-service/src",
    "outDir": "./playground-service/dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["playground-service/src/**/*.ts"],
  "exclude": ["node_modules", "playground-service/dist"]
}
